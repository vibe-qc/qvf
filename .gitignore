# Local source archives stay in dist/ or an explicit external output directory.
dist/
cpp/build/
__pycache__/
*.pyc
*.qvf
# …but the conformance golden, negative and legacy corpora are committed frozen test vectors.
!conformance/corpus/*.qvf
!conformance/negative/*.qvf
!conformance/legacy/*.qvf
.pytest_cache/
# Python packaging build artifacts.
build/
*.egg-info/
python/dist/
