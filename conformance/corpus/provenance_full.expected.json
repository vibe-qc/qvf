        "provenance",
        "software",
        1,
        "url"
      ],
      "equals": "https://example.org/integral-lib"
    },
    {
      "manifest_pointer": [
        "provenance",
        "software",
        2,
        "x_build"
      ],
      "equals": "release"
    },
    {
      "manifest_pointer": [
        "provenance",
        "git_commit"
      ],
      "equals": "3e8a1c5f7b2d49608a1b3c5d7e9f0a2b4c6d8e1f"
    },
    {
      "manifest_pointer": [
        "provenance",
        "n_threads"
      ],
      "equals": 8
